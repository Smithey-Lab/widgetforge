      "default": "count",
      "options": [
        [
          "count",
          "Count of records"
        ],
        [
          "sum",
          "Sum of a field"
        ],
        [
          "avg",
          "Average of a field"
        ],
        [
          "max",
          "Maximum"
        ],
        [
          "min",
          "Minimum"
        ]
      ]
    },
    {
      "key": "aggField",
      "label": "Field",
      "type": "text",
