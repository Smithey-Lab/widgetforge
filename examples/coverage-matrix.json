        "stats": "Unassigned | assigned_toISEMPTY\nCritical | priority=1"
      }
    },
    {
      "id": "number_1",
      "moduleId": "number",
      "x": 12,
      "y": 9,
      "w": 6,
      "h": 3,
      "settings": {
        "title": "Open",
        "agg": "count",
        "caption": "right now",
        "suffix": ""
      }
    },
    {
      "id": "gauge_1",
      "moduleId": "gauge",
      "x": 18,
      "y": 9,
      "w": 6,
      "h": 7,
      "settings": {
        "title": "Against target",
        "target": 250,
        "caption": "open vs the ceiling"
      }
    },
    {
      "id": "line_1",
      "moduleId": "line",
      "x": 0,
      "y": 12,
      "w": 18,
      "h": 4,
      "settings": {
        "title": "Opened per day",
        "dateField": "opened_at",
        "days": 30,
        "fill": true
